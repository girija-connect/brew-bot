<?xml version="1.0"?>
<robot name="cafe_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensors">
    <link name="laser_link">
    <inertial>
      <origin xyz="0 1.26046e-18 -0.00132878" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="4.71442e-05" ixy="1.05038e-21" ixz="3.93892e-22"
               iyy="4.71442e-05" iyz="-2.98785e-22" izz="6.79562e-05"/>
    </inertial>
      <visual>
        <origin xyz="0 0 -0.0184" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/laser_link.stl"/></geometry>
        <material name="lidar_dark_gray">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
    </link>
    <joint name="laser_joint" type="fixed">
      <origin xyz="0.187 0 0.176" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="laser_link"/>
    </joint>

    <link name="camera_link">
      <inertial>
        <origin xyz="-0.00473528 -4.64571e-07 -7.51228e-08" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="2.02866e-05" ixy="-2.70765e-11" ixz="-4.36887e-13"
                 iyy="3.97072e-06" iyz="1.82451e-11" izz="2.03281e-05"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/camera_link.dae"/></geometry>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <origin xyz="0.1598 0 ${head_z + 0.183}" rpy="0 0 0"/>
      <parent link="tower_link"/>
      <child link="camera_link"/>
    </joint>

    <gazebo reference="laser_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <ignition_frame_id>laser_link</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>-2.356</min_angle>
              <max_angle>2.356</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="head_camera" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>camera/image_raw</topic>
        <ignition_frame_id>camera_link</ignition_frame_id>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
