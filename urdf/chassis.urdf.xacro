<?xml version="1.0"?>
<robot name="cafe_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="chassis">
    <link name="chassis_link">
    <inertial>
      <origin xyz="-2.26621e-10 -2.09553e-10 0.0289739" rpy="0 0 0"/>
      <mass value="14.0"/>
      <inertia ixx="0.190313" ixy="5.58101e-10" ixz="2.24329e-10"
               iyy="0.258103" iyz="1.94163e-10" izz="0.399289"/>
    </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/chassis_link.dae"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_dir}/chassis_link_collision.stl"/></geometry>
      </collision>
    </link>
    <joint name="chassis_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="chassis_link"/>
    </joint>

    <link name="tower_link">
    <inertial>
      <origin xyz="-0.00094814 -8.10145e-09 0.779428" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.77087" ixy="-1.06794e-08" ixz="-0.00192916"
               iyy="0.760457" iyz="-1.21852e-08" izz="0.19169"/>
    </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/tower_link.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.106" rpy="0 0 0"/>
        <geometry><box size="0.44 0.4 0.028"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.06 0.185 0.5025" rpy="0 0 0"/>
        <geometry><box size="0.08 0.03 0.785"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.06 -0.185 0.5025" rpy="0 0 0"/>
        <geometry><box size="0.08 0.03 0.785"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.0125 0 0.3" rpy="0 0 0"/>
        <geometry><box size="0.405 0.4 0.014"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.0125 0 0.49" rpy="0 0 0"/>
        <geometry><box size="0.405 0.4 0.014"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.0125 0 0.68" rpy="0 0 0"/>
        <geometry><box size="0.405 0.4 0.014"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.019 0 0.9675" rpy="0 0 0"/>
        <geometry><box size="0.4385 0.4 0.215"/></geometry>
      </collision>
    </link>
    <joint name="tower_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="tower_link"/>
    </joint>

    <link name="front_panel_link">
    <inertial>
      <origin xyz="0.218853 -3.17866e-07 0.0300001" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00054668" ixy="7.6996e-11" ixz="2.49286e-11"
               iyy="2.92357e-05" iyz="-5.6814e-10" izz="0.000518447"/>
    </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/front_panel_link.dae"/></geometry>
      </visual>
    </link>
    <joint name="front_panel_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="front_panel_link"/>
    </joint>

    <link name="status_dots_link">
    <inertial>
      <origin xyz="0.2235 0 0.03" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="4.40667e-06" ixy="-0" ixz="-4.88265e-19"
               iyy="1.23333e-07" iyz="-0" izz="4.29e-06"/>
    </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/status_dots_link.dae"/></geometry>
      </visual>
    </link>
    <joint name="status_dots_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="status_dots_link"/>
    </joint>
  </xacro:macro>
</robot>
